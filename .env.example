# Site Configuration
# The portfolio lives at the root and the blog at /blog, so a custom domain
# should leave PATH_PREFIX empty.
GATSBY_SITE_URL=https://falghifari.com

# Path prefix for GitHub Pages project sites only (e.g. /repo-name).
# Leave empty for a custom domain.
PATH_PREFIX=

# Google Analytics (Optional - remove or leave empty to disable)
# GATSBY_GA_TRACKING_ID=UA-164225247-3
